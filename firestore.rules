// Default deny. A signed-in player can read profiles and places.
// Rating and rated matches change only when a singles result is confirmed.
// inviteLinks/{token} is the only read open to signed-out visitors, and only by document id.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Connected means the pair document exists and both players accepted.
    function isConnected(otherId) {
      let id = pairId(request.auth.uid, otherId);
      return exists(/databases/$(database)/documents/connectionPairs/$(id))
        && get(/databases/$(database)/documents/connectionPairs/$(id)).data.status == 'accepted';
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function isMatchParticipant(matchId) {
      return signedIn() && request.auth.uid in matchData(matchId).participantIds;
    }

    match /profiles/{uid} {
      allow get, list: if signedIn();
      // Created only when the player finishes sign-up. Rating starts from their level.
      allow create: if false;
      // A player can edit their own profile. Rating and rated matches stay as they are.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.ratedMatches == resource.data.ratedMatches;
      allow delete: if false;
    }

    match /locations/{id} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if false;
    }

    match /connections/{id} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.addresseeId is string
        && request.resource.data.requesterId != request.resource.data.addresseeId
        && request.resource.data.status == 'pending'
        && request.resource.data.pairId == pairId(request.resource.data.requesterId, request.resource.data.addresseeId)
        && !exists(/databases/$(database)/documents/connectionPairs/$(request.resource.data.pairId));
      // Only the player who was asked can accept or decline.
      allow update: if signedIn()
        && request.auth.uid == resource.data.addresseeId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.addresseeId == resource.data.addresseeId;
      allow delete: if false;
    }

    match /connectionPairs/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    match /matchLists/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /opportunities/{id} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'open';
      // The host can cancel an open opportunity. "Match fixed" is not a client write.
      allow update: if signedIn()
        && request.auth.uid == resource.data.hostId
        && resource.data.status == 'open'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.hostId == resource.data.hostId;
      allow delete: if false;
    }

    match /invitations/{id} {
      allow get, list: if signedIn()
        && (request.auth.uid == resource.data.hostId || request.auth.uid == resource.data.inviteeId);
      allow create: if false;
      // The invitee can say Maybe or Can't play, or clear that, while the opportunity is still open.
      // "I'm in" is refused here. It confirms the match in one transaction.
      allow update: if signedIn()
        && request.auth.uid == resource.data.inviteeId
        && request.resource.data.response in ['none', 'maybe', 'out']
        && request.resource.data.inviteeId == resource.data.inviteeId
        && request.resource.data.opportunityId == resource.data.opportunityId
        && get(/databases/$(database)/documents/opportunities/$(resource.data.opportunityId)).data.status == 'open';
      allow delete: if false;
    }

    match /inviteLinks/{token} {
      // Anyone with the link can read that one invite. Listing every invite is refused.
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /matches/{id} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && resource.data.status == 'scheduled'
        && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }

    match /results/{id} {
      allow get: if isMatchParticipant(resource.data.matchId);
      allow list: if false;
      allow create: if false;
      // The other player can dispute a pending result. Confirming it is not a client write.
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'disputed'
        && request.auth.uid != resource.data.reportedBy
        && isMatchParticipant(resource.data.matchId);
      allow delete: if false;
    }

    match /ratingHistory/{id} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    match /availabilities/{id} {
      // Your own times, or a connection's times when the query names that one player.
      allow get, list: if signedIn() && (
        resource.data.profileId == request.auth.uid || isConnected(resource.data.profileId)
      );
      allow create: if signedIn()
        && request.resource.data.profileId == request.auth.uid
        && request.resource.data.endsAt > request.resource.data.startsAt;
      allow update: if signedIn()
        && resource.data.profileId == request.auth.uid
        && request.resource.data.profileId == request.auth.uid
        && request.resource.data.endsAt > request.resource.data.startsAt;
      allow delete: if false;
    }

    match /notifications/{id} {
      allow get, list: if signedIn() && resource.data.profileId == request.auth.uid;
      allow create: if false;
      // The player can only mark their own inbox item read.
      allow update: if signedIn()
        && resource.data.profileId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }
  }
}
