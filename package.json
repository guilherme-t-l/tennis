{
  "name": "tennis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emu": "NEXT_PUBLIC_FIREBASE_EMULATOR=true bash scripts/with-java.sh firebase emulators:exec --only auth,firestore \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:db": "bash scripts/with-java.sh firebase emulators:exec --only auth,firestore \"vitest run tests/db\"",
    "test:e2e": "env -u PLAYWRIGHT_BROWSERS_PATH bash scripts/with-java.sh firebase emulators:exec --only auth,firestore \"playwright test\"",
    "seed": "tsx scripts/seed.ts",
    "deploy:firebase": "firebase deploy --only firestore:rules,firestore:indexes,auth"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.31.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
