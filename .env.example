# Copy to .env.local for local emulator work: cp .env.example .env.local
# Local project id is demo-tennis. Do not point these at a hosted project until you supply a real id.

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-tennis.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-tennis
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# true only in .env.local. Never set this on Vercel.
NEXT_PUBLIC_FIREBASE_EMULATOR=

NEXT_PUBLIC_APP_URL=http://localhost:3000
E2E_USER_PASSWORD=Password123!

# Hosted Admin SDK only. Omit when the emulators are running.
# FIREBASE_SERVICE_ACCOUNT_JSON=
